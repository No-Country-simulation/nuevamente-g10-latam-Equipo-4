{
  "name": "novamente-atlas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "npm run dev -w @atlas/web",
    "dev:api": "npm run dev -w @atlas/api",
    "build": "npm run build -w @atlas/api && npm run build -w @atlas/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @atlas/api && .venv/bin/python -m unittest discover -s services/cognition/tests -v",
    "smoke": "node scripts/smoke.mjs",
    "check:eve": "node scripts/check-eve.mjs",
    "init:vault": "node scripts/init-vault.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "guarded-fetch": "0.1.6"
  }
}
